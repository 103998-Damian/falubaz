# Unreal Engine 5 – gitignore

# Skompilowane pliki binarne
Binaries/
Intermediate/
DerivedDataCache/

# Zapisane dane edytora i logi
Saved/

# Zawartość (duże assety wykluczone)
Content/StarterContent/
Content/Models/
Content/__ExternalActors__/
Content/__ExternalObjects__/

# Visual Studio
.vs/
*.sln
*.suo
*.user

# Pliki generowane przez UE
*.VC.db
*.opensdf
*.sdf
*.sln
*.xcworkspace
*.xcodeproj

# Pliki konfiguracyjne lokalne
Config/DefaultEngine.ini.bak
